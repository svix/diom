{% macro field_name(field) -%}
    {%- set name = field.name -%}
    {%- if name is endingwith "_ms" -%}
        {%- set name = name | strip_trailing_str("_ms") -%}
    {%- endif -%}
    {{ name | to_lower_camel_case }}
{%- endmacro -%}

{% macro render_example_resource(resource) -%}

{%- if resource.kind == "string_enum" -%}
    {{ resource.name | to_upper_camel_case }}.{{ resource.values[0] | to_upper_camel_case }}
{%- elif resource.kind == "integer_enum" -%}
    {{ resource.name | to_upper_camel_case }}.{{ resource.variants[0][0] | to_upper_camel_case }}
{%- else -%}
    {%- set non_positional_fields = resource.fields | selectattr("positional", "false") -%}
new {{ resource.name | to_upper_camel_case }}()
    {%- for field in non_positional_fields %}
    .{{ field.name | to_lower_camel_case }}({{ field_example(field) }})
    {%- endfor %}

    {%- if resource.kind == "struct_enum" -%}
        {%- set variant = resource.variants[1] -%}
        {%- set variant_val -%}
            new {{ resource.name | to_upper_camel_case }}{{ resource.content_field | to_upper_camel_case }}.{{ variant.name | to_upper_camel_case }}(
                {%- if variant.schema_ref is defined -%}
                    {{ render_example_resource(variant.inner) | indent(4) }}
                {%- endif -%}
            )
        {%- endset -%}
        .{{ resource.content_field | to_lower_camel_case }}({{ variant_val }})
    {%- endif -%}
{%- endif %}

{%- endmacro -%}

{% macro field_example(field) -%}
    {%- if field.type.is_uri() -%}
        {%- if field.example is defined -%}
        URI.create("{{ field.example }}")
        {%- else -%}
        URI.create("https://example.com/")
        {%- endif -%}
    {%- elif field.type.is_string() -%}
        {%- if field.example is defined -%}
        "{{ field.example }}"
        {%- else -%}
        "sample string"
        {%- endif -%}
    {%- elif field.type.is_unix_timestamp_ms() -%}
        Instant.parse("2026-04-20 12:00:00Z")
    {%- elif field.type.is_duration_ms() -%}
        Duration.ofSeconds(30)
    {%- elif field.type.is_map() -%}
        {%- if field.example is defined -%}
            Map.ofEntries(
            {%- for key, val in field.example | items -%}
                Map.entry("{{ key }}", "{{ val }}"){% if not loop.last %},{% endif -%}
            {%- endfor -%}
            )
        {%- else -%}
        Map.of()
        {%- endif -%}
    {%- elif field.type.is_json_object() -%}
        Map.of()
    {%- elif field.type.is_int_or_uint() -%}
        {%- set int_suffix -%}
            {%- if field.type.to_java() == "Long" -%}
            L
            {%- endif -%}
        {%- endset -%}
        {%- if field.example is defined -%}
            {{ field.example | fix_serde_number_repr }}{{ int_suffix }}
        {%- else -%}
            1{{ int_suffix }}
        {%- endif -%}
    {%- elif field.type.is_schema_ref() %}
        {{ render_example_resource(field.type.inner_schema_ref_ty()) | indent(8) }}
    {% elif field.type.is_set() or field.type.is_list() %}
        {%- set list_keyword %}{% if field.type.is_set() -%}Set{% else -%}List{% endif -%}{% endset -%}
        {%- if field.example is defined -%}
        {{ list_keyword }}.of(
            {%- for v in field.example -%}
            "{{ v }}"{% if not loop.last %},{% endif -%}
            {%- endfor -%}
        )
        {%- else -%}
        {{ list_keyword }}.of()
        {%- endif -%}
    {%- elif field.type.is_bool() %}
        true
    {%- else -%}
        {{ panic("missing example def for field") }}
    {%- endif -%}
{% endmacro -%}

{# build the resource path (for example: ingest.source) -#}
{% set resource_path -%}
    {% for resource_name in resource_parents -%}
        .get{{ resource_name | to_upper_camel_case }}
    {%- endfor -%}
{% endset -%}

{#- output starts here #}
{%- if operation.response_body_schema_name is defined %}var response = {% endif -%}
diom{{ resource_path }}.{{ operation.name | to_lower_camel_case }}
{%- if operation.request_body_schema_name is defined -%}

{%- set body_schema = api.types[operation.request_body_schema_name] %}
{%- set positional_fields = body_schema.fields | selectattr("positional") -%}
(
    {#- positional body parameters #}
    {%- for field in positional_fields %}
    {{ field_example(field) }},
    {%- endfor %}
    {#- non-positional body parameters #}
    {{ render_example_resource(req_body_ty) | indent(4) }}
)

{%- else %}()
{%- endif %};
